# LyricStudio Environment Configuration
# Copy this template to .env and configure your secure values for local development.
# NEVER commit your actual .env file to Git.

# Administrator Account Credentials (Required)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_password_in_production

# Application Secret Key (Optional - auto-generated if omitted)
# LYRICSTUDIO_SECRET_KEY=your_random_secret_key_here

# Session Cookie Security (Set to true in production over HTTPS)
LYRICSTUDIO_SECURE_COOKIE=false

# Supabase Authentication & Project Settings
# Get these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
# Strictly backend-only; NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Storage & Quotas (in Megabytes)
MAX_STORAGE_PER_USER_MB=5000

# Google Gemini API Key (For neural lyric transcription & creative direction)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
